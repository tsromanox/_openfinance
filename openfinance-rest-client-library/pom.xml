<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.8</version>
        <relativePath/>
    </parent>

    <groupId>br.com.openfinance</groupId>
    <artifactId>openfinance-rest-client-library</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    
    <name>OpenFinance REST Client Library</name>
    <description>High-performance REST client library with reactive and imperative implementations supporting up to 50k concurrent requests</description>

    <modules>
        <module>rest-client-core</module>
        <module>rest-client-reactive</module>
        <module>rest-client-imperative</module>
        <module>rest-client-events</module>
        <module>rest-client-starter</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        
        <!-- Spring -->
        <spring-boot.version>3.4.8</spring-boot.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        
        <!-- OpenAPI -->
        <openapi-generator.version>7.14.0</openapi-generator.version>
        <springdoc.version>2.8.9</springdoc.version>
        <jackson-databind-nullable.version>0.2.6</jackson-databind-nullable.version>
        
        <!-- Resilience -->
        <resilience4j.version>2.3.0</resilience4j.version>
        
        <!-- Database -->
        <r2dbc.version>1.0.0.RELEASE</r2dbc.version>
        <postgresql.version>42.7.2</postgresql.version>
        <r2dbc-postgresql.version>1.0.1.RELEASE</r2dbc-postgresql.version>
        
        <!-- Testing -->
        <testcontainers.version>1.20.4</testcontainers.version>
        <wiremock.version>3.9.2</wiremock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            
            <!-- Internal Modules -->
            <dependency>
                <groupId>br.com.openfinance</groupId>
                <artifactId>rest-client-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.openfinance</groupId>
                <artifactId>rest-client-reactive</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.openfinance</groupId>
                <artifactId>rest-client-imperative</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.openfinance</groupId>
                <artifactId>rest-client-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            
            <!-- Resilience4j -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            
            <!-- OpenAPI -->
            <dependency>
                <groupId>org.openapitools</groupId>
                <artifactId>jackson-databind-nullable</artifactId>
                <version>${jackson-databind-nullable.version}</version>
            </dependency>
            
            <!-- TestContainers -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>--enable-preview</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>